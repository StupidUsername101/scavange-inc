# Godot 4+ specific ignores
.godot/
/android/

# Unused third-party particle addon.
/addons/pixelpart/

# Local commercial source libraries. Only the deliberately curated runtime subset under
# assets/third_party is imported and versioned; these vaults contain duplicate source formats.
/assets/environment/**
!/assets/environment/.gdignore
/assets/sounds/effects/**
!/assets/sounds/effects/.gdignore

# Reproducible diagnostics generated by the acoustic stress/probe suites.
/tests/generated/

# Local Python bytecode from asset-catalog tooling.
__pycache__/
*.py[cod]
