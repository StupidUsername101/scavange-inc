# Godot 4+ specific ignores
.godot/
native/sdf_backend/.sconsign.dblite
native/sdf_backend/obj/
native/sdf_backend/bin/
native/sdf_backend/src/*.o
native/sdf_backend/src/*.os
native/sdf_backend/src/*.obj
.native-deps/
/android/

# Unused third-party particle addon.
/addons/pixelpart/

# Local commercial source libraries. Only the deliberately curated runtime subset under
# assets/third_party is imported and versioned; these vaults contain duplicate source formats.
/assets/environment/**
!/assets/environment/.gdignore
/assets/sounds/effects/**
!/assets/sounds/effects/.gdignore

# Local commercial character source vault. The eight explicitly referenced runtime variants are
# force-added to the repository; the rest of the bundle and its redundant source ZIP stay local.
/assets/Characters_psx_01/**
/assets/Characters_psx_1.1.zip

# Native binaries are reproducible CI artifacts. Source, descriptor, and the bin placeholder are
# versioned; each platform downloads/builds the matching library instead of committing host output.
/addons/scavange_sdf/bin/*
!/addons/scavange_sdf/bin/.gitkeep

# Reproducible diagnostics generated by the acoustic stress/probe suites.
/tests/generated/

# Local packaged builds; export_presets.cfg is the reproducible source of truth.
/builds/

# Local Python bytecode from asset-catalog tooling.
__pycache__/
*.py[cod]
